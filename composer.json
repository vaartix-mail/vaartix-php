{
    "name": "vaartix/vaartix-php",
    "description": "Official PHP SDK for the Vaartix email API",
    "type": "library",
    "license": "MIT",
    "keywords": ["email", "transactional-email", "api", "india", "vaartix", "ses", "sdk", "laravel"],
    "homepage": "https://vaartix.com",
    "support": {
        "docs": "https://vaartix.com/docs/",
        "issues": "https://github.com/vaartix-mail/vaartix-php/issues",
        "source": "https://github.com/vaartix-mail/vaartix-php"
    },
    "authors": [
        { "name": "NAP Designs", "email": "support@vaartix.com", "homepage": "https://vaartix.com" }
    ],
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": { "Vaartix\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Vaartix\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
